API_BASE_URL=https://api.frankfurter.dev/v1
DB_PATH=data/fx.sqlite
CACHE_DIR=cache
USE_CACHE_LATEST=false
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
TIMEOUT_SECONDS=20
MAX_RETRIES=3
TWELVE_DATA_API_KEY=
FRED_API_KEY=
FX_API_KEY=
CRYPTO_API_KEY=
MACRO_API_KEY=
LIVE_DEFAULT_DAYS=365
LIVE_MAX_FREE_DAYS=365
LIVE_HISTORY_MODE=standard
LIVE_ADVANCED_MAX_YEARS=10
# Use LIVE_HISTORY_MODE=advanced only with paid providers that support longer historical ranges.
FX_PROVIDER=frankfurter
CRYPTO_PROVIDER=coingecko
STOCK_PROVIDER=twelvedata
MACRO_PROVIDER=bcb_sgs
COINGECKO_API_PLAN=public
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_DEMO_MODE=false
API_HOST=127.0.0.1
API_PORT=8000
